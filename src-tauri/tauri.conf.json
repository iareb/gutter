{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gutter",
  "version": "0.1.0",
  "identifier": "io.github.iareb.gutter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "gutter",
        "width": 1024,
        "height": 768,
        "minWidth": 360,
        "minHeight": 480,
        "theme": "Dark",
        "backgroundColor": "#111113"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
